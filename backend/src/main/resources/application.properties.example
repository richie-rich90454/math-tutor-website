# ============================================
# MathTutor AI Backend - Configuration Example
# Copy this file to application.properties and
# provide values via environment variables.
# ============================================

# ---------- Server ----------
# SERVER_PORT=8080

# ---------- Database ----------
# Path to the SQLite database file (created if missing).
# DATABASE_PATH=./data/math-tutor.db

# ---------- Auth ----------
# Required. Long random string (>= 256 bits).
# SESSION_SECRET=

# ---------- AI (OpenAI-compatible) ----------
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
# OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
# OPENAI_COMPATIBLE_VISION_MODEL=

# ---------- CORS ----------
# Comma-separated list of allowed origins for the frontends.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Prompts ----------
# Directory containing prompt-<lang>.txt files (classpath by default).
# PROMPTS_CLASSPATH_DIR=prompts

# ---------- Legacy client ----------
# Filesystem directory that serves the IE6 legacy client under /legacy/**.
# LEGACY_STATIC_DIR=../frontend-legacy

# ---------- Quota (per-user daily token cap) ----------
# APP_QUOTA_DAILY_TOKENS=200000
# APP_QUOTA_SOFT_RATIO=0.80
# APP_QUOTA_MONTHLY_TOKENS=0

# ---------- SMTP (email verification, currently a stub — not wired) ----------
# APP_SMTP_HOST=
# APP_SMTP_PORT=587
# APP_SMTP_USERNAME=
# APP_SMTP_PASSWORD=
# APP_SMTP_FROM=noreply@mathtutor.example
# APP_AUTH_VERIFY_EMAIL=false
