# ============================================
# MathTutor AI - Environment Configuration
# ============================================

# ---------- OpenAI ----------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- Database ----------
# Choose one: postgresql OR sqlite
DB_TYPE=sqlite

# For PostgreSQL (when DB_TYPE=postgresql):
POSTGRES_URL=jdbc:postgresql://localhost:5432/mathtutor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For SQLite (when DB_TYPE=sqlite):
SQLITE_PATH=jdbc:sqlite:./data/mathtutor.db

# ---------- Spring Profile ----------
# dev = SQLite, prod = PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# ---------- Server ----------
# Arbitrary 5-digit port. In production, both backend and frontend
# are served on this single port. In dev, Vite (5173) proxies /api here.
SERVER_PORT=16789

# ---------- JWT ----------
# could generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))
JWT_SECRET=change-me-to-a-long-random-string-at-least-256-bits-long
JWT_EXPIRATION_MS=604800000
