# ============================================
# MathTutor AI - Environment Configuration
# ============================================

# ---------- AI (OpenAI-compatible) ----------
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash

# ---------- Auth ----------
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-256-bits-long

# ---------- Database ----------
# Defaults to ./data/math-tutor.db if unset
DATABASE_PATH=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- Backend (Spring Boot) ----------
# Next.js proxies /api/* and /legacy/* to this backend URL (see next.config.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---------- Quota (per-user daily token cap) ----------
# APP_QUOTA_DAILY_TOKENS=200000
# APP_QUOTA_SOFT_RATIO=0.80
# APP_QUOTA_MONTHLY_TOKENS=0

# ---------- SMTP (email verification stub, not wired) ----------
# APP_SMTP_HOST=
# APP_SMTP_PORT=587
# APP_SMTP_USERNAME=
# APP_SMTP_PASSWORD=
# APP_SMTP_FROM=noreply@mathtutor.example
# APP_AUTH_VERIFY_EMAIL=false
