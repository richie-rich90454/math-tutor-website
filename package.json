{
    "name": "math-tutor-website",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "dev:next": "next dev --turbopack",
        "build:next": "next build",
        "start:next": "next start",
        "dev:frontend": "cd frontend-modern && npm run dev",
        "build:frontend": "cd frontend-modern && npm run build && node ../copy-legacy.js",
        "dev:backend": "cd backend && mvn spring-boot:run",
        "build:backend": "cd backend && mvn clean package -DskipTests",
        "dev:all": "concurrently -n frontend,backend -c cyan,green \"cd frontend-modern && npm run dev\" \"cd backend && mvn spring-boot:run\"",
        "start:backend": "java -jar backend/target/math-tutor-backend-*.jar",
        "lint": "eslint src/",
        "format": "prettier --write .",
        "test": "vitest run",
        "typecheck": "cd frontend-modern && npx tsc --noEmit",
        "build": "npm run build:frontend && npm run build:backend",
        "db:init:sqlite": "sqlite3 backend/data/mathtutor.db < scripts/db-init-sqlite.sql || echo 'See scripts/db-init-sqlite.sql'",
        "db:init:postgres": "psql -d mathtutor -f scripts/db-init-postgres.sql || echo 'See scripts/db-init-postgres.sql'",
        "db:migrate:sqlite": "echo 'JPA auto-migrates on startup (ddl-auto: update). Manual: sqlite3 backend/data/mathtutor.db < scripts/db-init-sqlite.sql'",
        "db:migrate:postgres": "echo 'JPA auto-migrates on startup (ddl-auto: update). Manual: psql -d mathtutor -f scripts/db-init-postgres.sql'",
        "db:clear:sqlite": "echo 'UNDESIRED - destroys all data'; sqlite3 backend/data/mathtutor.db < scripts/db-clear-sqlite.sql",
        "db:clear:postgres": "echo 'UNDESIRED - destroys all data'; psql -d mathtutor -f scripts/db-clear-postgres.sql"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "better-sqlite3": "^12.11.1",
        "gsap": "^3.15.0",
        "next": "^16.2.9",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "uuid": "^14.0.1",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "concurrently": "^10.0.4",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.9",
        "oxfmt": "^0.61.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.10"
    }
}
