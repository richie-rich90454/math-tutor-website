{
    "name": "math-tutor-website",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "dev": "node scripts/run-all.js frontend:dev backend:dev",
        "start": "node scripts/run-all.js frontend:start backend:start",
        "build": "node scripts/run-all.js frontend:build backend:build",
        "test": "npm run frontend:test && npm run backend:test",
        "format": "oxfmt --write .",
        "frontend:dev": "node scripts/minify-json.js && next dev --turbopack",
        "frontend:build": "node scripts/minify-json.js && next build",
        "frontend:start": "next start",
        "frontend:lint": "eslint src/",
        "frontend:test": "node scripts/minify-json.js && vitest run",
        "frontend:typecheck": "node scripts/minify-json.js && tsc --noEmit",
        "frontend:legacy:i18n": "node scripts/generate-legacy-i18n.js",
        "frontend:e2e": "playwright test",
        "backend:dev": "cd backend && mvn spring-boot:run",
        "backend:build": "cd backend && mvn package",
        "backend:start": "cd backend && java -jar target/math-tutor-backend-1.0.0.jar",
        "backend:test": "cd backend && mvn test"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "gsap": "^3.15.0",
        "next": "^16.3.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.3.0",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitest/coverage-v8": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "critters": "^0.0.23",
        "eslint": "^10.8.1",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.9.0",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.62.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
